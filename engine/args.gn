# Vanta engine GN args (Linux x64). Goal: behave exactly like Google Chrome 157 stable
# on the web (same codecs, same version string, same features), but with no Google
# account/API keys baked in and no debug symbols. Safe Browsing stays ON.
is_official_build = true
is_debug = false
is_component_build = false
symbol_level = 0
blink_symbol_level = 0
chrome_pgo_phase = 0
exclude_unwind_tables = true
treat_warnings_as_errors = false
fatal_linker_warnings = false
clang_use_chrome_plugins = false
blink_enable_generated_code_formatting = false

# Web-visible parity with Google Chrome
proprietary_codecs = true
ffmpeg_branding = "Chrome"
enable_widevine = true
use_unofficial_version_number = false

# Privacy: no Google keys, no field-trial config baked in
google_api_key = ""
google_default_client_id = ""
google_default_client_secret = ""
use_official_google_api_keys = false
disable_fieldtrial_testing_config = true

# Linux platform
use_sysroot = true
use_vaapi = true
rtc_use_pipewire = true
use_kerberos = false
use_qt5 = false
use_qt6 = false
use_siso = false
